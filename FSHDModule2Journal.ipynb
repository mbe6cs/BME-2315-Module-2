    "import pandas as pd\n",
    "\n",
    "#Load information about all MRI slices\n",
    "info = pd.read_csv(folder / \"slice_info.csv\")\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "\n",
    "#analyze both timepoints and plot the mean fat fraction along the TA muscle\n",
    "for timepoint in [\"TP1\", \"TP2\"]:\n",
    "\n",
    "    locations = []\n",
    "    means = []\n",
    "\n",
    "    visit = info[info[\"timepoint\"] == timepoint]\n",
    "\n",
    "    for _, row in visit.iterrows():\n",
    "\n",
    "        water = np.load(folder / row[\"water_file\"]).astype(float)\n",
    "        fat = np.load(folder / row[\"fat_file\"]).astype(float)\n",
    "        mask = np.load(folder / row[\"mask_file\"]) > 0\n",
    "\n",
    "        total = water + fat\n",
    "        valid = mask & np.isfinite(total) & (total > 0)\n",
    "\n",
    "        ff = fat[valid] / total[valid] * 100\n",
    "\n",
    "        locations.append(row[\"percent_along_muscle\"])\n",
    "        means.append(np.mean(ff))\n",
    "\n",
    "    plt.plot(locations, means, marker=\"o\", label=timepoint)\n",
    "#plot the mean fat fraction along the TA muscle for both timepoints\n",
    "plt.title(\"TA Fat Fraction: TP1 vs TP2\")\n",
    "plt.xlabel(\"Location Along Muscle (%)\")\n",
    "plt.ylabel(\"Mean Fat Fraction (%)\")\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
