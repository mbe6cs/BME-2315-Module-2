   "source": [
    "#Select the patients with complete MRI and QMT measurements\n",
    "time_cols = [\"lag_months_baseline\", \"lag_months_y1\", \"lag_months_y2\"]\n",
    "\n",
    "ff_cols = [\"ff_baseline_R\", \"ff_y1_R\", \"ff_y2_R\"]\n",
    "\n",
    "qmt_cols = [\n",
    "    \"dorsiflexion_qmt_R_baseline\",\n",
    "    \"dorsiflexion_qmt_R_y1\",\n",
    "    \"dorsiflexion_qmt_R_y2\"\n",
    "]\n",
    "\n",
    "complete = df.dropna(subset=time_cols + ff_cols + qmt_cols).copy()\n",
    "\n",
    "#Function for linear interpolation\n",
    "def interpolate_patient(row, columns, target):\n",
    "    times = [row[col] for col in time_cols]\n",
    "    values = [row[col] for col in columns]\n",
    "\n",
    "    f = interp1d(times, values, kind=\"linear\")\n",
    "    return float(f(target))\n",
    "\n",
    "#Interpolate both measurements at T1 and T2\n",
    "for name, columns in [(\"FF\", ff_cols), (\"QMT\", qmt_cols)]:\n",
    "    complete[name + \"_T1\"] = complete.apply(\n",
    "        lambda row: interpolate_patient(row, columns, T1), axis=1\n",
    "    )\n",
    "    complete[name + \"_T2\"] = complete.apply(\n",
    "        lambda row: interpolate_patient(row, columns, T2), axis=1\n",
    "    )\n",
    "#print the number of patients included in the analysis and display the first few rows of the relevant data\n",
    "print(\"Patients included:\", len(complete))\n",
    "#display the first few rows of the data with the interpolated values for FF and QMT at T1 and T2\n",
    "display(complete[[\n",
    "    \"subject_id\", \"FF_T1\", \"FF_T2\", \"QMT_T1\", \"QMT_T2\"\n",
    "]].head())"
   ]
  },
