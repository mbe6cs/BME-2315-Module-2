    "print(\"Standard deviation:\", round(complete[\"FF_change\"].std(), 2))\n",
    "\n",
    "print(\"\\nMuscle Strength (QMT):\")\n",
    "print(\"Mean % change:\", round(complete[\"QMT_change\"].mean(), 2))\n",
    "print(\"Standard deviation:\", round(complete[\"QMT_change\"].std(), 2))"
