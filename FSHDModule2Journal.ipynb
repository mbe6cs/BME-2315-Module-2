    "#importing the libraries we need for this analysis\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "\n",
    "#Find the folder containing the MRI data\n",
    "folder = Path(\"FSHD_MRI_data\") / \"FSHD_TA_MRI_data_0020_TP1_TP2\"\n",
    "#load all the images and masks for the first MRI slice\n",
    "water = np.load(folder / \"TP1_slice_01_water.npy\").astype(float)\n",
    "fat = np.load(folder / \"TP1_slice_01_fat.npy\").astype(float)\n",
    "mask = np.load(folder / \"TP1_slice_01_mask.npy\") > 0\n",
    "\n",
    "#Identify the TA muscle and calculate fat fraction\n",
    "total = water + fat\n",
    "valid = np.isfinite(total) & (total > 0)\n",
    "\n",
    "ff = np.full(total.shape, np.nan)\n",
    "ff[valid] = fat[valid] / total[valid] * 100\n",
    "\n",
    "#separate the fat fraction values for the whole image and the TA muscle\n",
    "whole = ff[valid]\n",
    "muscle = ff[mask & valid]\n",
    "\n",
    "#Calculate summary statistics\n",
    "print(\"Whole image mean:\", round(np.mean(whole), 2), \"%\")\n",
    "print(\"TA mean:\", round(np.mean(muscle), 2), \"%\")\n",
    "print(\"TA median:\", round(np.median(muscle), 2), \"%\")\n",
    "print(\"TA standard deviation:\", round(np.std(muscle), 2))\n",
    "print(\"TA muscle pixels:\", np.count_nonzero(mask))\n",
    "\n",
    "#Display the MRI fat fraction map\n",
    "plt.figure(figsize=(6, 5))\n",
    "plt.imshow(np.where(mask, ff, np.nan),\n",
    "           cmap=\"viridis\", vmin=0, vmax=100)\n",
    "plt.colorbar(label=\"Fat Fraction (%)\")\n",
    "plt.title(\"TA Fat Fraction - TP1, Slice 01\")\n",
    "plt.xlabel(\"Pixel Column\")\n",
    "plt.ylabel(\"Pixel Row\")\n",
    "plt.show()\n",
    "\n",
    "#display fat fraction distribution\n",
    "plt.figure(figsize=(6, 4))\n",
    "plt.hist(muscle, bins=15, edgecolor=\"black\")\n",
    "plt.title(\"TA Fat Fraction Distribution\")\n",
    "plt.xlabel(\"Fat Fraction (%)\")\n",
    "plt.ylabel(\"Number of Pixels\")\n",
    "plt.show()\n",
    "\n",
    "#Compare MRI slices along the muscle\n",
    "slices = []\n",
    "means = []\n",
    "\n",
    "for file in sorted(folder.glob(\"TP1_slice_*_water.npy\")):\n",
    "    prefix = file.stem.replace(\"_water\", \"\")\n",
    "\n",
    "    w = np.load(file).astype(float)\n",
    "    f = np.load(folder / f\"{prefix}_fat.npy\").astype(float)\n",
    "    m = np.load(folder / f\"{prefix}_mask.npy\") > 0\n",
    "#only include pixels that have valid measurements\n",
    "    total = w + f\n",
    "    valid_pixels = m & np.isfinite(total) & (total > 0)\n",
    "#if the slice doesnt have valid pixels you can skip it\n",
    "    if not np.any(valid_pixels):\n",
    "        continue\n",
    "\n",
    "    values = f[valid_pixels] / total[valid_pixels] * 100\n",
    "    slices.append(int(prefix.split(\"_\")[2]))\n",
    "    means.append(np.mean(values))\n",
    "#plot the mean fat fraction along the TA muscle\n",
    "plt.figure(figsize=(7, 4))\n",
    "plt.plot(slices, means, marker=\"o\")\n",
    "plt.title(\"Mean Fat Fraction Along the TA Muscle\")\n",
    "plt.xlabel(\"MRI Slice Number\")\n",
    "plt.ylabel(\"Mean Fat Fraction (%)\")\n",
    "plt.grid(True)\n",
    "plt.show()\n",
    "\n",
    "\n"
   ]
