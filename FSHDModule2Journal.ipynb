    "#This is to compare linear and quadratic interpolation for all 21 patients\n",
    "\n",
    "def quadratic_change(row, columns):\n",
    "    times = [row[col] for col in time_cols]\n",
    "    values = [row[col] for col in columns]\n",
    "\n",
    "    f = interp1d(times, values, kind=\"quadratic\")\n",
    "\n",
    "    value_T1 = float(f(T1))\n",
    "    value_T2 = float(f(T2))\n",
    "\n",
    "    return (value_T2 - value_T1) / value_T1 * 100\n",
    "\n",
    "#Calculate quadratic percentage changes\n",
    "complete[\"FF_quad_change\"] = complete.apply(\n",
    "    lambda row: quadratic_change(row, ff_cols), axis=1\n",
    ")\n",
    "\n",
    "complete[\"QMT_quad_change\"] = complete.apply(\n",
    "    lambda row: quadratic_change(row, qmt_cols), axis=1\n",
    ")\n",
    "\n",
    "#Compare average changes\n",
    "print(\"MRI Fat Fraction:\")\n",
    "print(\"Linear mean:\", round(complete[\"FF_change\"].mean(), 2))\n",
    "print(\"Quadratic mean:\", round(complete[\"FF_quad_change\"].mean(), 2))\n",
    "\n",
    "print(\"\\nMuscle Strength (QMT):\")\n",
    "print(\"Linear mean:\", round(complete[\"QMT_change\"].mean(), 2))\n",
    "print(\"Quadratic mean:\", round(complete[\"QMT_quad_change\"].mean(), 2))\n",
    "\n",
    "#Visualize the comparison\n",
    "plt.figure(figsize=(8, 5))\n",
    "\n",
    "plt.scatter(\n",
    "    complete[\"FF_change\"],\n",
    "    complete[\"FF_quad_change\"],\n",
    "    label=\"MRI Fat Fraction\"\n",
    ")\n",
    "\n",
    "plt.scatter(\n",
    "    complete[\"QMT_change\"],\n",
