    "#Calculate the percentage change from T1 to T2\n",
    "complete[\"FF_change\"] = (\n",
    "    (complete[\"FF_T2\"] - complete[\"FF_T1\"])\n",
    "    / complete[\"FF_T1\"]\n",
    ") * 100\n",
    "\n",
    "complete[\"QMT_change\"] = (\n",
    "    (complete[\"QMT_T2\"] - complete[\"QMT_T1\"])\n",
    "    / complete[\"QMT_T1\"]\n",
    ") * 100\n",
    "\n",
    "#Display each of the patient's changes\n",
    "display(complete[[\n",
    "    \"subject_id\", \"FF_change\", \"QMT_change\"\n",
    "]].round(2))\n",
    "\n",
    "#Calculate mean and standard deviation\n",
    "print(\"MRI Fat Fraction:\")\n",
